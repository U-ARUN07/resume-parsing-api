# PostgreSQL Database Connection URL (SQLAlchemy 2.x with psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/resume_parser_db

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Application Environment (development, testing, production)
APP_ENV=development

# Server Configuration
HOST=127.0.0.1
PORT=8000
